# Copy to functions/.env (not committed) and adjust. The API key is NOT set here:
# it is a Secret Manager secret:  firebase functions:secrets:set ANTHROPIC_API_KEY
HOOSHVARE_MODEL=claude-sonnet-5-5
# Comma-separated origins allowed to call the function (your GitHub Pages origin, no path).
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io,http://localhost:5173
# Cost guards. Raising them is a spending decision.
DAILY_REQUEST_CAP=300
DAILY_OUTPUT_TOKEN_CAP=300000
IP_HOURLY_CAP=30
IP_DAILY_CAP=120
